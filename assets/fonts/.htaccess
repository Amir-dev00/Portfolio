# Self-hosted Manrope + Estedad (+ icon webfonts). cPanel/Apache friendly.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType application/vnd.ms-fontobject .eot
</IfModule>

# Long-cache immutable font binaries (filenames are versioned by content).
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Allow cross-origin font use if the admin subdomain differs from the site host.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
