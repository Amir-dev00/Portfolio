APP_NAME="AZ Portfolio"
# Local: APP_ENV=local, APP_DEBUG=true, APP_URL=http://127.0.0.1:8000
# cPanel: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.com
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Laravel 13 requires PHP 8.3 or newer on the host.

# Book a Call is self-hosted (Admin → Bookings). Optional SMTP for email notices:
# MAIL_MAILER=smtp / MAIL_HOST=… — bookings still work if mail is unset.
# Optional SMS.ir owner SMS after confirm (SMSIR_* below) — also non-blocking.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): true. Local http://127.0.0.1:8000: set to false or you cannot log in.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS.ir owner alert after a confirmed Book a Call (optional; bookings still succeed if SMS fails).
# Create an API key + sending line in the SMS.ir panel, then set real values only in private .env.
SMSIR_ENABLED=false
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_OWNER_MOBILE=
# SMSIR_TIMEOUT=5

# Homepage AI portfolio assistant (OpenAI Responses API). Keys stay in portfolio-app/.env only —
# never inside public_html. Hosting must allow outbound HTTPS to api.openai.com.
ASSISTANT_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# ASSISTANT_TIMEOUT=22
# ASSISTANT_MAX_OUTPUT_TOKENS=450
# ASSISTANT_MAX_MESSAGE_CHARS=500
# ASSISTANT_MAX_HISTORY_TURNS=8
# ASSISTANT_RATE_LIMIT=20
# ASSISTANT_RATE_DECAY_MINUTES=60
# ASSISTANT_DAILY_GLOBAL_CAP=400

# Optional override for where published media is written.
# Leave empty: public_html/media/published on cPanel (public_html/index.php sets the public path),
# cms/public/media/published locally.
PUBLISHED_MEDIA_PATH=
