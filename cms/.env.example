APP_NAME="AZ Portfolio"
# Local: APP_ENV=local, APP_DEBUG=true, APP_URL=http://127.0.0.1:8000
# cPanel: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.com
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Laravel 13 requires PHP 8.3 or newer on the host.

# Optional fallback for the "Book a Call" button (your own https Cal.com or Calendly link).
# The URL saved in Admin -> Site content -> Booking takes priority over this value.
BOOKING_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): true. Local http://127.0.0.1:8000: set to false or you cannot log in.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional override for where published media is written.
# Leave empty: public_html/media/published on cPanel (public_html/index.php sets the public path),
# cms/public/media/published locally.
PUBLISHED_MEDIA_PATH=
